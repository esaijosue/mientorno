# MiEntorno - Variables de configuración de la plataforma
# Copie este archivo como .env para ajustar parámetros operativos locales.

# Nombre del sistema
APP_NAME=MiEntorno

# Coordenadas iniciales por defecto (WGS84 - Lima / Callao)
DEFAULT_LAT=-12.0464
DEFAULT_LON=-77.0428
DEFAULT_LOCATION_NAME="Lima / Callao (frente operativo)"

# Centrado nacional de respaldo (Perú)
PERU_LAT=-9.189967
PERU_LON=-75.015152
PERU_ZOOM=6

# Umbral de advertencia para imprecisión de señal GPS (metros)
ACCURACY_THRESHOLD=500

# Intervalo de refresco automático de telemetría (milisegundos, ej. 600000 = 10 min)
REFRESH_INTERVAL_MS=600000

# Servicios externos (APIs públicas sin clave requerida)
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
GEOCODING_API_URL="https://nominatim.openstreetmap.org/search"
